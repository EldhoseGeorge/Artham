{
  "manifest_version": 3,
  "name": "അർത്ഥം",
  "version": "1.0",
  "description": "English-Malayalam dictionary",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "128": "data/icon.png"
  }
}
